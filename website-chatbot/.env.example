# Get this from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Model used to answer questions (see https://console.groq.com/docs/models for the current list)
GROQ_MODEL=openai/gpt-oss-120b

# Port the server runs on
PORT=3000

# Comma-separated list of origins allowed to call this API (your website's domain(s))
# Example: https://www.yoursite.com,https://yoursite.com
ALLOWED_ORIGINS=*
